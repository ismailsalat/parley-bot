# ============================================================
#  Parley - the only three settings kept in this file.
#  Everything else (channels, staff roles, messages, categories,
#  cooldowns, test/live mode...) is set inside Discord:
#      /setup   then   /settings
# ============================================================

# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Leave empty to use a local database file (waypoint.db).
# On Railway use the PostgreSQL reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# production or development
ENVIRONMENT=production

# ------------------------------------------------------------
# Optional technical settings (you normally don't need these):
# LOG_LEVEL=INFO                 DEBUG shows full error details
# LOG_FORMAT=text                json for hosting platforms
# LOG_TO_FILE=true               also write logs/parley.log
# RUN_MIGRATIONS_ON_STARTUP=true
# SYNC_COMMANDS=true
#
# Older versions used MAIN_GUILD_ID, *_CHANNEL_ID and STAFF_ROLE_IDS here.
# They still work, but /settings -> Channels can save them to the database
# so you can delete them.
# ------------------------------------------------------------

# --- Verify My Servers (listing without installing Parley) ---
# Lets a user prove which servers they manage with a read-only Discord login,
# so a server can be listed without adding the bot. Leave blank to turn it off.
# The secret belongs in Railway variables - never in this file in git.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
